<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="leulit_20221117_1102_informe">
            <t t-call="web.html_container">
                <meta charset="utf-8"/>
                <!-- font-family fijado explícitamente (DejaVu Sans: la única confirmada en
                     dockerserver/Dockerfile) en vez de dejarlo al fallback del renderer, y
                     line-height explícito en cada <p> en vez del hack de margin-top negativo
                     que cancelaba el margen UA por defecto de <p> (frágil: dependía de que el
                     motor de render usara ~1em de margen). Solo afecta a esta plantilla: las
                     etiquetas de caja/estantería son templates propios en este mismo fichero. -->
                <table class="fullwidth" style="border-collapse:collapse; font-family:'DejaVu Sans', Arial, Helvetica, sans-serif;">
                    <thead>
                        <tr>
                            <th style="width:25mm; border-bottom: 1px solid black">
                                <p style="font-weight: bold;font-size:10px;text-align:left;margin-top:8px;">ÍCARUS</p>
                                <p style="font-size: 5px;text-align:left;font-weight: normal;margin-top:-10px;">MANTENIMENT,S.L.</p>
                                <p style="font-size: 5px;text-align:left;font-weight: normal;margin-top:-4px;">EASA PART 145. E-173</p>
                            </th>
                            <th style="width:60mm; border-bottom: 1px solid black">
                                <p style="font-size:20px; text-align:center;font-weight: bold;"><span t-esc="titulo"/></p>
                            </th>
                            <th style="width:20mm; border-bottom: 1px solid black">
                                <p style="font-weight: normal;margin:0mm; vertical-aling:center; text-align:center; font-size:8px">Ref M.O.E. 2.3</p>
                                <p style="font-weight: normal;margin:0mm; vertical-aling:center; text-align:center; font-size:8px">Formato: <span t-esc="formato"/></p>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <!-- Campo y valor van en la misma <tr> de una tabla anidada (antes eran dos
                                 columnas de <p> apiladas por separado): si un valor envuelve a una
                                 segunda línea, la fila crece y desplaza hacia abajo por igual a la
                                 etiqueta y al valor de esa fila y de todas las siguientes. Con listas
                                 de <p> independientes el desplazamiento solo afectaba a la columna de
                                 valores, descuadrando etiqueta y valor a partir de ahí. -->
                            <td colspan="2" style="vertical-align:top; border:1px solid transparent;">
                                <table style="border-collapse:collapse; border-spacing:0;">
                                    <tr>
                                        <td style="width:25mm; font-weight:bold; font-size:13px; line-height:14px; padding:0; vertical-align:top;">PN:</td>
                                        <td style="width:60mm; font-size:13px; line-height:14px; padding:0; vertical-align:top;"><span t-esc="pn"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">PN Alt.:</td>
                                        <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="pn_alternativo"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">Nombre:</td>
                                        <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="pn_nombre"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">SN:</td>
                                        <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="sn"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">Revisión:</td>
                                        <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="revision"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">Lote:</td>
                                        <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="lote"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">R.Origen:</td>
                                        <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="ref_origen"/></td>
                                    </tr>
                                    <t t-if="titulo=='MATERIAL NUEVO'">
                                        <tr>
                                            <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">Fecha Alta:</td>
                                            <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="fecha_alta"/></td>
                                        </tr>
                                        <tr>
                                            <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">F.Caducidad:</td>
                                            <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="fecha_caducidad"/></td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <t t-if="titulo == 'MATERIAL ÚTIL' or titulo == 'M. PTE. DECISIÓN'">
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">O.Trabajo:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="codigo_wo"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">T.S.N:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="tsn"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">T.S.O:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="tso"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">V.Operativa:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="o_life_hours"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">Fecha Alta:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="fecha_alta"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">F.Caducidad:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="fecha_caducidad"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">Posición:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="posicion"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">Sistema:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="sistema"/></td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">O.Trabajo:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="codigo_wo"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">T.S.N:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="tsn"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">T.S.O:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="tso"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">V.Operativa:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="o_life_hours"/></td>
                                            </tr>
                                            <tr>
                                                <td style="font-weight:bold; font-size:10px; line-height:12px; padding:0; vertical-align:top;">Motivo baja:</td>
                                                <td style="font-size:10px; line-height:12px; padding:0; vertical-align:top;"><span t-esc="motivo_baja"/></td>
                                            </tr>
                                        </t>
                                    </t>
                                </table>
                            </td>
                            <td style="vertical-align:top; overflow-y: hidden; border:1px solid transparent;">
                                <t t-if="qr != ''">
                                    <img t-att-src="qr" style="width:auto;height:25mm;"/>
                                    <!-- <img t-att-src="'data:image/png;base64,%s' % qr" style="width:auto;height:25mm;"/> -->
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </template>

        <template id="leulit_20260818_1350_informe">
            <t t-call="web.html_container">
                <!-- Este <meta> parece redundante -web.report_layout ya pone charset en el <head>-
                     pero no lo es: ir_actions_report._prepare_html() solo conserva el <head> si el
                     documento trae un <div class="article"> (lo que ponen web.basic_layout /
                     external_layout). Sin el, se queda con el contenido de <main> pelado y se lo
                     pasa a wkhtmltopdf sin cabecera: asume latin-1 y los acentos salen mal. La
                     etiqueta de pieza de arriba lleva el mismo meta por lo mismo. -->
                <meta charset="utf-8"/>
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <table class="fullwidth" style="border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th style="width:25mm; border-bottom: 1px solid black">
                                        <p style="font-weight: bold;font-size:10px;text-align:left;margin-top:8px;">ÍCARUS</p>
                                        <p style="font-size: 5px;text-align:left;font-weight: normal;margin-top:-10px;">MANTENIMENT,S.L.</p>
                                        <p style="font-size: 5px;text-align:left;font-weight: normal;margin-top:-4px;">EASA PART 145. E-173</p>
                                    </th>
                                    <th style="width:60mm; border-bottom: 1px solid black">
                                        <p style="font-size:20px; text-align:center;font-weight: bold;">CAJA</p>
                                    </th>
                                    <th style="width:20mm; border-bottom: 1px solid black">
                                        <p style="font-weight: normal;margin:0mm; text-align:center; font-size:8px">Ref M.O.E. 2.3</p>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="vertical-align:top; border:1px solid transparent;font-weight: bold;">
                                        <p style="font-size:13px">Caja:</p>
                                        <p style="font-size:9px;margin-top:-7px;">Estantería:</p>
                                    </td>
                                    <td style="vertical-align:top; border:1px solid transparent;">
                                        <div style="width: 60mm;">
                                            <p style="font-size:13px;"><span t-esc="o.name"/></p>
                                            <p style="font-size:9px;margin-top:-7px;"><span t-esc="o.estanteria_id.display_name or '-'"/></p>
                                        </div>
                                    </td>
                                    <td style="vertical-align:top; overflow-y: hidden; border:1px solid transparent;">
                                        <t t-if="o.qr">
                                            <img t-att-src="'data:image/png;base64,%s' % o.qr.decode()" style="width:auto;height:25mm;"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>

