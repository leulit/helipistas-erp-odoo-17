<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!--
            Popup "Adjuntar Documentos" reutilizado desde la pestaña "Documentos" de
            cualquier ficha (alumno, piloto, operador, mecánico...) mediante el botón
            del modelo leulit.documento (método add_docs).
        -->
        <record model="ir.ui.view" id="leulit_documento_adjuntar_form">
            <field name="name">leulit_documento_adjuntar_form</field>
            <field name="model">leulit.documento</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Adjuntar Documentos">
                    <group col="1">
                        <h3>Selecciona todos los archivos que deseas adjuntar:</h3>
                        <field name="rel_docs" nolabel="1"/>
                    </group>
                    <footer>
                        <button string="Guardar y cerrar" name="action_close" type="object" class="btn-primary"/>
                        <button string="Descartar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!--
            Asistente para lanzar a mano el rescate de adjuntos sueltos del clip del
            chatter (alumno/mecánico/calidad/camo/empleado) al modelo unificado
            leulit.documento. Solo visible para administradores (grupo
            base.group_system), ver menú "Ajustes".
        -->
        <record model="ir.ui.view" id="leulit_documento_migrar_wizard_form">
            <field name="name">leulit_documento_migrar_wizard_form</field>
            <field name="model">leulit.documento_migrar_wizard</field>
            <field name="arch" type="xml">
                <form string="Migrar documentos antiguos">
                    <group>
                        <p>
                            Migra a "Documentos" (modelo único, colgado del contacto) los adjuntos
                            que aún viven sueltos en el clip del chatter de alumno, mecánico,
                            trabajador de calidad, personal CAMO y empleado.
                        </p>
                        <p>
                            No borra nada de lo antiguo. Se puede ejecutar más de una vez: lo ya
                            migrado no se vuelve a duplicar.
                        </p>
                        <field name="resumen" invisible="not resumen" widget="text"/>
                    </group>
                    <footer>
                        <button string="Migrar" name="action_migrar" type="object" class="btn-primary"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="leulit_documento_migrar_wizard_action">
            <field name="name">Migrar documentos antiguos</field>
            <field name="res_model">leulit.documento_migrar_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
