<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="leulit_hr_employee_form_view">
            <field name="name">leulit_hr_employee_form_view</field>
            <field name="model">hr.employee</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='identification_group']" position="after">
                    <group string="Gastos" name="leulit_gastos_group" groups="leulit.ROperaciones_gestor">
                        <field name="plus_festivo_nacional"/>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
