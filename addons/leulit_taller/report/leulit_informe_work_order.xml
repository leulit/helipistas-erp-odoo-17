<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="wo_report_css">
            <meta charset="utf-8"/>
            <style>
                html {
                    font-family: sans-serif; /* 1 */
                    -ms-text-size-adjust: 100%; /* 2 */
                    -webkit-text-size-adjust: 100%; /* 2 */
                }
                .fullwidth {
                    width: 100%;
                    border-collapse: collapse;
                }
                .sectiontitle {
                    font-size: 13px;
                    text-transform: uppercase;
                    margin-top: 14px;
                    margin-bottom: 2px;
                }
                .wolabel {
                    font-size: 12px;
                }
                .fieldvalue {
                    font-weight: normal;
                    font-size: 12px;
                }
                .centertext {text-align:center !important;}
                .heightrow {height: 32px;}
                .nowrap {white-space: nowrap;}
                thead { display: table-header-group }
                tfoot { display: table-header-group }
                tr { page-break-inside: avoid }
                th, tbody td, tfoot td {
                    border: 1px solid #000000;
                    padding: 2px 5px;
                    text-align:left;
                    font-size:12px;
                    font-weight:normal;
                }
                td{
                    vertical-align: middle
                }
            </style>
        </template>

        <template id="leulit_20230905_1226_informe">
            <t t-call="web.html_container">
                <t t-call="leulit_taller.wo_report_css"/>

                <div class="header" style="font-family:Sans">
                    <t t-call="leulit_taller.wo_report_css"/>
                    <t t-if="logo_hlp">
                        <table class="fullwidth">
                            <tr>
                                <td style="text-align:center; width:20%;">
                                    <img t-att-src="'data:image/png;base64,%s' % logo_hlp" style="width:auto; max-height:35px;"/>
                                </td>
                                <td style="font-size:26px; white-space: nowrap; text-align:center; width:62%;">
                                    <span><b>WORK ORDER</b></span>
                                </td>
                                <td style="font-size:9px; white-space: nowrap; text-align:right; width:18%; line-height:1.2;">
                                    <span>ES.CAMO.005</span><br/>
                                    <span>Formato 6 E5R2</span><br/>
                                    <span>10/08/2026</span>
                                </td>
                            </tr>
                        </table>
                    </t>
                    <t t-if="logo_ica">
                        <table class="fullwidth">
                            <tr>
                                <td style="font-size:12px; white-space: nowrap; text-align:center; width:33%;" rowspan="3">
                                    <img t-att-src="'data:image/png;base64,%s' % logo_ica" style="width:auto; max-height:30px;"/><br/>
                                    <span>ES. 145.173</span>
                                </td>
                                <td style="font-size:20px; white-space: nowrap; text-align:center; width:33%;" rowspan="2">
                                    <span><b>WORK ORDER</b></span>
                                </td>
                                <td style="font-size:12px; white-space: nowrap; text-align:center; width:17%;">
                                    <span>Referencia:</span>
                                </td>
                                <td style="font-size:12px; white-space: nowrap; text-align:center; width:16%;">
                                    <span>M.O.E. 2.13</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-size:12px; white-space: nowrap; text-align:center">
                                    <span>Formato:</span>
                                </td>
                                <td style="font-size:12px; white-space: nowrap; text-align:center">
                                    <span>2.0</span>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-size:18px; white-space: nowrap; text-align:center">
                                    <span t-esc="name"/>
                                </td>
                                <td style="font-size:12px; white-space: nowrap; text-align:center">
                                    <span>Revisión:</span>
                                </td>
                                <td style="font-size:12px; white-space: nowrap; text-align:center">
                                    <span>Rev. 3-2023</span>
                                </td>
                            </tr>
                        </table>
                    </t>
                </div>
                <div class="article" style="font-family:Sans">
                    <div class="page">
                        <t t-call="leulit_taller.wo_report_css"/>

                        <!-- DATOS DE LA WORK ORDER -->
                        <table class="fullwidth">
                            <tr>
                                <td class="wolabel" style="width:32%;">Work order number</td>
                                <td class="fieldvalue"><span t-esc="name"/></td>
                            </tr>
                            <tr>
                                <td class="wolabel">Work order date</td>
                                <td class="fieldvalue"><span t-esc="fecha_emision"/></td>
                            </tr>
                            <tr>
                                <td class="wolabel">Issued by</td>
                                <td class="fieldvalue"><span t-esc="name_user"/></td>
                            </tr>
                            <tr>
                                <td class="wolabel">Maintenance organization</td>
                                <td class="fieldvalue">
                                    <span t-esc="organizacion_mant"/>
                                    <span t-if="organizacion_mant"> (ES.145.173)</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="wolabel">Received by</td>
                                <td class="fieldvalue">
                                    <span t-esc="responsable_mant"/>
                                    <t t-if="fecha_aceptacion"> - <span t-esc="fecha_aceptacion"/></t>
                                </td>
                            </tr>
                        </table>

                        <!-- AIRCRAFT INFORMATION -->
                        <div class="sectiontitle">Aircraft information:</div>
                        <table class="fullwidth">
                            <tr>
                                <td class="fieldvalue" style="width:25%;">Aircraft Reg.: <span t-esc="matricula"/></td>
                                <td class="fieldvalue" style="width:25%;">Aircraft type: <span t-esc="marca_aeronave"/> <span t-esc="modelo_aeronave"/></td>
                                <td class="fieldvalue" style="width:25%;">Aircraft S/N: <span t-esc="sn_aeronave"/></td>
                                <td class="fieldvalue" style="width:25%;">AC/TT: <span t-esc="tsn_aeronave"/></td>
                            </tr>
                            <tr>
                                <td class="fieldvalue" colspan="4">AMP: <span t-esc="plan_mantenimiento"/></td>
                            </tr>
                        </table>

                        <!-- DESCRIPTION OF ORDERED WORK -->
                        <div class="sectiontitle">Description of ordered work:</div>
                        <table class="fullwidth">
                            <tr>
                                <td class="wolabel centertext heightrow" style="width:6%;">Item</td>
                                <td class="wolabel" style="width:50%;">Description of work</td>
                                <td class="wolabel centertext" style="width:24%;">Reference</td>
                                <td class="wolabel centertext" style="width:20%;">Sign</td>
                            </tr>
                            <t t-set="cont" t-value="1"/>
                            <t t-foreach="trabajos_realizar" t-as="trabajo_tag">
                                <tr>
                                    <td class="fieldvalue centertext"><span t-esc="cont"/></td>
                                    <t t-if="trabajo_tag not in ['Others','']">
                                        <td class="fieldvalue" colspan="3"><b>Rev. <span t-esc="trabajo_tag"/>h</b></td>
                                    </t>
                                    <t t-else="">
                                        <td class="fieldvalue" colspan="3"><b><span t-esc="trabajo_tag"/></b></td>
                                    </t>
                                </tr>
                                <t t-foreach="trabajos_realizar[trabajo_tag]" t-as="tarea">
                                    <tr>
                                        <td class="fieldvalue centertext heightrow"><span t-esc="tarea[0]"/></td>
                                        <td class="fieldvalue heightrow"><span t-esc="tarea[1]"/></td>
                                        <td class="fieldvalue centertext heightrow"><span t-esc="tarea[2]"/></td>
                                        <td class="fieldvalue centertext heightrow">
                                            <t t-if="tarea[5]"><b>N/A</b><br/></t>
                                            <span t-esc="tarea[3]"/>
                                            <t t-if="tarea[4]"><br/><span style="font-size:10px;">Sup.: <span t-esc="tarea[4]"/></span></t>
                                        </td>
                                    </tr>
                                </t>
                                <t t-set="cont" t-value="cont+1"/>
                            </t>
                        </table>

                        <!-- SERVICE BULLETINS AND AIRWORTHINESS DIRECTIVES -->
                        <div class="sectiontitle">Service bulletins and airworthiness directives:</div>
                        <table class="fullwidth">
                            <tr>
                                <td class="wolabel centertext heightrow" style="width:6%;">Item</td>
                                <td class="wolabel" style="width:50%;">Description of work</td>
                                <td class="wolabel centertext" style="width:24%;">Reference</td>
                                <td class="wolabel centertext" style="width:20%;">Sign</td>
                            </tr>
                            <t t-if="service_bulletins">
                                <t t-foreach="service_bulletins" t-as="tarea">
                                    <tr>
                                        <td class="fieldvalue centertext heightrow"><span t-esc="tarea['item']"/></td>
                                        <td class="fieldvalue heightrow"><span t-esc="tarea['name']"/></td>
                                        <td class="fieldvalue centertext heightrow"><span t-raw="tarea['referencia']"/></td>
                                        <td class="fieldvalue centertext heightrow">
                                            <span t-esc="tarea['asignado']"/>
                                            <t t-if="tarea['supervisado_por']"><br/><span style="font-size:10px;">Sup.: <span t-esc="tarea['supervisado_por']"/></span></t>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="range(2)" t-as="i">
                                    <tr>
                                        <td class="fieldvalue heightrow"/>
                                        <td class="fieldvalue heightrow"/>
                                        <td class="fieldvalue heightrow"/>
                                        <td class="fieldvalue heightrow"/>
                                    </tr>
                                </t>
                            </t>
                        </table>

                        <!-- SPECIAL INSTRUCTIONS AND/OR REPORTED DEFECTS -->
                        <div class="sectiontitle">Special instructions and/or reported defects:</div>
                        <table class="fullwidth">
                            <tr>
                                <td class="wolabel centertext heightrow" style="width:6%;">Item</td>
                                <td class="wolabel" style="width:50%;">Description of work</td>
                                <td class="wolabel centertext" style="width:24%;">Reference</td>
                                <td class="wolabel centertext" style="width:20%;">Sign</td>
                            </tr>
                            <t t-if="anomalias">
                                <t t-foreach="anomalias" t-as="anomalia">
                                    <tr>
                                        <td class="fieldvalue centertext heightrow"><span t-esc="anomalia['item']"/></td>
                                        <td class="fieldvalue heightrow"><span t-esc="anomalia['name']"/></td>
                                        <td class="fieldvalue centertext heightrow"><span t-raw="anomalia['referencia']"/></td>
                                        <td class="fieldvalue centertext heightrow"><span t-esc="anomalia['asignado']"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="range(2)" t-as="i">
                                    <tr>
                                        <td class="fieldvalue heightrow"/>
                                        <td class="fieldvalue heightrow"/>
                                        <td class="fieldvalue heightrow"/>
                                        <td class="fieldvalue heightrow"/>
                                    </tr>
                                </t>
                            </t>
                        </table>

                        <!-- COMPONENT REPLACEMENT -->
                        <div class="sectiontitle">Component replacement:</div>
                        <table class="fullwidth">
                            <tr>
                                <td class="wolabel heightrow" style="width:6%;"/>
                                <td class="wolabel centertext" style="width:15%;">P/N</td>
                                <td class="wolabel centertext" style="width:15%;">S/N</td>
                                <td class="wolabel centertext" style="width:28%;">Description</td>
                                <td class="wolabel centertext" style="width:8%;">TSN</td>
                                <td class="wolabel centertext" style="width:8%;">TSO</td>
                                <td class="wolabel centertext" style="width:20%;">Sign</td>
                            </tr>
                            <t t-if="moves_componentes">
                                <t t-foreach="moves_componentes" t-as="move_componente">
                                    <tr>
                                        <td class="wolabel centertext heightrow">OFF</td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['off_pn']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['off_sn']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['off_descripcion']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['off_tsn']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['off_tso']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['off_realizado_por']"/></td>
                                    </tr>
                                    <tr>
                                        <td class="wolabel centertext heightrow">ON</td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['on_pn']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['on_sn']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['on_descripcion']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['on_tsn']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['on_tso']"/></td>
                                        <td class="fieldvalue centertext"><span t-esc="move_componente['on_realizado_por']"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="['OFF', 'ON']" t-as="sentido">
                                    <tr>
                                        <td class="wolabel centertext heightrow"><span t-esc="sentido"/></td>
                                        <td class="fieldvalue"/>
                                        <td class="fieldvalue"/>
                                        <td class="fieldvalue"/>
                                        <td class="fieldvalue"/>
                                        <td class="fieldvalue"/>
                                        <td class="fieldvalue"/>
                                    </tr>
                                </t>
                            </t>
                        </table>

                        <!-- REMARKS / NOTES -->
                        <div class="sectiontitle">Remarks / Notes:</div>
                        <table class="fullwidth">
                            <tr>
                                <td class="fieldvalue" style="height: 90px; vertical-align: top;">
                                    <span t-esc="observaciones"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="footer">
                    <div style="text-align:right;font-size:10px;"><b>Página:</b> <span class="page"/> de <span class="topage"/></div>
                </div>
            </t>
        </template>
    </data>
</odoo>
